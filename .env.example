# Environment variables for The Influence Archive.
#
# Copy this file to `.env.local`. Every value below has a working default, so
# nothing is required for local development.

# The database. A postgres:// URL is used as-is. `pglite:<path>` opens an
# in-process database, which the test harness uses.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# Connection pool size.
DATABASE_POOL_SIZE=10

# The local database server, started by `npm run db:serve`.
PGLITE_PORT=5433
PGLITE_PATH=./.data/pglite

# Where uploaded and seeded images are stored.
MEDIA_ROOT=media

# Used for canonical URLs, the sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run db:admin`. The password is hashed before it is
# stored and is never written to the database or the logs in plain text.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-passphrase
