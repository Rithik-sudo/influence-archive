{
  "name": "influence-archive",
  "version": "0.1.0",
  "private": true,
  "description": "The Influence Archive \u2014 an editorial archive of influential people.",
  "scripts": {
    "dev": "node --conditions=react-server --import tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NODE_OPTIONS='--conditions=react-server' playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed/cli.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/seed/verify-cli.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "db:admin": "node --conditions=react-server --import tsx scripts/provision-admin.ts",
    "dev:app": "next dev",
    "db:serve": "node --conditions=react-server --import tsx scripts/db-serve.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "drizzle-orm": "0.45.4",
    "hast-util-to-string": "3.0.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "^0.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
